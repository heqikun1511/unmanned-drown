{
  "configurations": [
    {
      "name": "STM32F103 FreeRTOS",
      "compilerPath": "/usr/bin/arm-none-eabi-gcc",
      "intelliSenseMode": "gcc-arm",
      "cStandard": "c11",
      "defines": [
        "USE_HAL_DRIVER",
        "STM32F103xE"
      ],
      "compilerArgs": [
        "-mcpu=cortex-m3",
        "-mthumb"
      ],
      "includePath": [
        "${workspaceFolder}/User",
        "${workspaceFolder}/Drivers",
        "${workspaceFolder}/Drivers/CMSIS/Include",
        "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F1xx/Include",
        "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc",
        "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc/Legacy",
        "${workspaceFolder}/Middlewares",
        "${workspaceFolder}/Middlewares/FreeRTOS/include",
        "${workspaceFolder}/Middlewares/FreeRTOS/portable/GCC/ARM_CM3",
        "${workspaceFolder}/interface",
        "${workspaceFolder}/static_task",
        "${workspaceFolder}/f01_flight/Core/Inc",
        "${workspaceFolder}/f01_flight/Drivers/CMSIS/Core/Include",
        "${workspaceFolder}/f01_flight/Drivers/CMSIS/Device/ST/STM32F1xx/Include",
        "${workspaceFolder}/f01_flight/Drivers/CMSIS/Include",
        "${workspaceFolder}/f01_flight/Drivers/STM32F1xx_HAL_Driver/Inc"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/User",
          "${workspaceFolder}/Drivers",
          "${workspaceFolder}/Drivers/CMSIS/Include",
          "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F1xx/Include",
          "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc",
          "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc/Legacy",
          "${workspaceFolder}/Middlewares",
          "${workspaceFolder}/Middlewares/FreeRTOS/include",
          "${workspaceFolder}/Middlewares/FreeRTOS/portable/GCC/ARM_CM3",
          "${workspaceFolder}/interface",
          "${workspaceFolder}/static_task",
          "${workspaceFolder}/f01_flight/Core/Inc",
          "${workspaceFolder}/f01_flight/Drivers/CMSIS/Core/Include",
          "${workspaceFolder}/f01_flight/Drivers/CMSIS/Device/ST/STM32F1xx/Include",
          "${workspaceFolder}/f01_flight/Drivers/CMSIS/Include",
          "${workspaceFolder}/f01_flight/Drivers/STM32F1xx_HAL_Driver/Inc"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}
